<odoo>
    <record id="view_calendar_event_form_inherit_timesheet_tab" model="ir.ui.view">
        <field name="name">calendar.event.form.timesheet.notebook</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Timesheet">
                    <group>
                        <div class="d-flex align-items-center justify-content-start gap-4" style="flex-wrap: nowrap;">
                            <button name="action_open_calendar_timesheet_wizard"
                                    type="object"
                                    string="Add to Timesheet"
                                    class="btn btn-primary"
                                    style="white-space: nowrap; height: 38px; line-height: 1.2; padding: 0 1.2rem; font-weight: 500;"
                                    groups="hr_timesheet.group_hr_timesheet_user"
                                    invisible="is_timesheet_logged"/>
                            <div class="d-flex align-items-center" style="white-space: nowrap;">
                                <span class="me-2" style="white-space: nowrap;">Timesheet Logged</span>
                                <field name="is_timesheet_logged"
                                       widget="boolean_toggle"
                                       readonly="1"/>
                            </div>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
