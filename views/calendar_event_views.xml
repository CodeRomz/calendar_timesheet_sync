<odoo>
    <record id="view_calendar_event_form_inherit_timesheet_tab" model="ir.ui.view">
        <field name="name">calendar.event.form.timesheet.notebook</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Timesheet">
                    <group>
                        <div class="d-flex align-items-center" name="timesheet_controls">
                            <button name="action_open_calendar_timesheet_wizard"
                                    type="object"
                                    string="Add to Timesheet"
                                    class="btn btn-secondary"
                                    style="white-space: nowrap;"
                                    groups="hr_timesheet.group_hr_timesheet_user"
                                    invisible="is_timesheet_logged"/>
                            <div class="ms-4">
                                <field name="is_timesheet_logged"
                                       string="Timesheet Status"
                                       widget="boolean_toggle"
                                       readonly="1"/>
                            </div>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
