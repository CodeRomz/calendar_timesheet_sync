<odoo>
  <record id="view_calendar_to_timesheet_wizard_form" model="ir.ui.view">
    <field name="name">calendar.to.timesheet.wizard.form</field>
    <field name="model">calendar.to.timesheet.wizard</field>
    <field name="arch" type="xml">
      <form string="Log Time from Calendar">
        <group>
          <field name="name"/>
          <field name="date_time_start"/>
          <field name="date_time_end"/>
          <field name="duration" readonly="1"/>
          <field name="project_id"/>
          <field name="task_id" domain="[('project_id', '=', project_id)]"/>
        </group>
        <footer>
          <button string="Log Time" type="object" name="action_log_time" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
